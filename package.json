    "url": "https://github.com/UnicornNinja-code/mobile-coffee-app/issues"
  },
  "homepage": "https://github.com/UnicornNinja-code/mobile-coffee-app#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
